---
const { title, description, url } = Astro.props;
---

<article class="group bg-white rounded-xl border border-slate-200 border-l-4 border-l-purple-600 overflow-hidden hover:border-l-purple-400 hover:bg-white hover:shadow-md transition-colors duration-200">
  <div class="flex flex-col px-6 py-6 gap-1">
    <h3 class="font-semibold text-slate-800 leading-snug group-hover:text-primary transition-colors">
      {title}
    </h3>
    <p class="text-sm text-slate-500 mt-1 mb-3 leading-relaxed">{description}</p>
    <a
      href={url}
      class="inline-flex items-center gap-1 text-sm font-semibold text-primary hover:gap-2 transition-all duration-200"
    >
      Aprender más
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
      </svg>
    </a>
  </div>
</article>
