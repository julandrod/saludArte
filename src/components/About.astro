---
import { idPages } from "../data";
import { bloodPressureTest } from "../assets";
import SectionTitle from "./SectionTitle.astro";
---

<section id={idPages.about} class="scroll-mt-20 bg-white py-20 md:py-28">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-12 lg:gap-16 items-center">

      <!-- Text -->
      <div class="fade-in">
        <SectionTitle title="Quienes somos" label="NOSOTROS" />
        <p class="text-lg text-slate-600 leading-relaxed">
          <span class="text-xl font-extrabold text-primary">SALUD</span><span
            class="text-2xl font-extrabold text-secondary">ARTE</span
          > es una empresa privada, conformada por un conjunto de profesionales
          médicos y auxiliares de enfermería, competentes y preparados, para
          prestar un servicio de salud con calidad, oportunidad y pertinencia, a
          la población quindiana, con el fin de utilizar una herramienta clínica
          para el diagnóstico y confirmación de hipertensión arterial, de manera
          confiable y segura.
        </p>
      </div>

      <!-- Image -->
      <div class="fade-in">
        <img
          class="rounded-2xl shadow-xl w-full object-cover"
          src={bloodPressureTest}
          alt="Monitor de presión arterial"
        />
      </div>

    </div>
  </div>
</section>
