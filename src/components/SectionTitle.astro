---
/* label  — optional small-caps eyebrow text above the heading */
const { title, label } = Astro.props;
---

<div class="mb-10 md:mb-14">
  <!-- {label && (
    <p class="text-xs font-bold tracking-widest uppercase text-primary mb-3">{label}</p>
  )} -->
  <h2 class="text-3xl md:text-4xl font-bold text-slate-900 leading-tight">{title}</h2>
  <div class="mt-4 w-12 h-1 bg-primary rounded-full"></div>
</div>
