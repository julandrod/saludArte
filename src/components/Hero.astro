---
import { doctors } from "../assets";
---

<section class="relative overflow-hidden bg-white">

  <!-- Decorative background shape behind image column -->
  <div class="absolute inset-y-0 right-0 w-1/2 bg-slate-50 hidden md:block" style="border-radius: 0 0 0 80px;"></div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24 lg:py-28">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-12 lg:gap-16 items-center">

      <!-- ── Text column ── -->
      <div class="fade-in">
        <p class="text-xs font-bold tracking-widest uppercase text-primary mb-5">
          Monitorización cardiovascular
        </p>

        <h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold text-slate-900 leading-tight mb-6">
          ¿Cuál es la forma más eficaz de saber si tienes
          <span class="text-primary"> Hipertensión arterial</span>?
        </h1>

        <p class="text-lg md:text-xl text-slate-600 leading-relaxed mb-8 max-w-lg">
          Existe un método técnico no invasivo, que mide la presión arterial durante 24 horas
        </p>

        <!-- CTA buttons -->
        <div class="flex flex-wrap gap-4 mb-10">
          <a
            href="#services"
            class="inline-flex items-center gap-2 px-7 py-3.5 rounded-full bg-primary text-white font-semibold text-base hover:bg-primary-dark transition-all duration-200 shadow-lg shadow-purple-200 hover:-translate-y-0.5"
          >
            Ver servicios
          </a>
          <a
            href="#contact"
            class="inline-flex items-center gap-2 px-7 py-3.5 rounded-full border-2 border-primary text-primary font-semibold text-base hover:bg-primary hover:text-white transition-all duration-200"
          >
            Contactar ahora
          </a>
        </div>

        <!-- Trust stats -->
        <div class="flex items-center gap-6 pt-4 border-t border-slate-100">
          <div>
            <p class="text-2xl font-bold text-slate-900">+500</p>
            <p class="text-xs text-slate-500 uppercase tracking-wide mt-1">pacientes</p>
          </div>
          <span class="w-px h-8 bg-slate-200"></span>
          <div>
            <p class="text-2xl font-bold text-slate-900">24h</p>
            <p class="text-xs text-slate-500 uppercase tracking-wide mt-1">monitoreo</p>
          </div>
          <span class="w-px h-8 bg-slate-200"></span>
          <div>
            <p class="text-2xl font-bold text-slate-900">🏠</p>
            <p class="text-xs text-slate-500 uppercase tracking-wide mt-1">A domicilio</p>
          </div>
        </div>
      </div>

      <!-- ── Image column ── -->
      <div class="relative flex justify-center items-center fade-in" style="animation-delay: 0.15s">
        <div class="relative overflow-hidden rounded-2xl bg-slate-50 w-full max-w-md lg:max-w-lg xl:max-w-xl">
          <!-- Purple glow blob -->
          <div class="absolute -inset-4 rounded-3xl bg-primary/5 blur-2xl"></div>
          <img
            class="relative w-full h-full object-contain object-center"
            src={doctors}
            alt="Médicos SaludArte"
          />
        </div>
      </div>

    </div>
  </div>
</section>
