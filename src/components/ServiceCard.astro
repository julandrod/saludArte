---
const { title, image } = Astro.props;
---

<article class="group flex flex-col bg-white border border-slate-200 rounded-2xl p-8 hover:shadow-lg hover:-translate-y-1 transition-all duration-300">
  <!-- Icon -->
  <div class="w-12 h-12 rounded-xl bg-purple-50 group-hover:bg-purple-600 flex items-center justify-center mb-6 transition-colors duration-200">
    <img
      class="w-6 h-6 transition-all duration-200 [filter:invert(27%)_sepia(93%)_saturate(1352%)_hue-rotate(250deg)] group-hover:[filter:brightness(0)_invert(1)]"
      src={image}
      alt={title}
    />
  </div>

  <!-- Title -->
  <h3 class="text-base font-semibold text-slate-800 leading-snug flex-1 mb-6">
    {title}
  </h3>

  <!-- Arrow link -->
  <a
    href="#contact"
    class="inline-flex items-center gap-1 text-sm font-semibold text-primary group-hover:gap-2 transition-all duration-200"
  >
    Solicitar servicio
    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
    </svg>
  </a>
</article>
