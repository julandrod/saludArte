---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Footer from "../../components/Footer.astro";
import { misionMonitor, visionMonitor } from "../../assets";
import SectionTitle from "../../components/SectionTitle.astro";
import Navbar from "../../components/Navbar";
---

<BaseLayout>
  <Navbar client:load />

  <main class="bg-white py-20 md:py-28">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-20 md:space-y-28">

      <!-- Misión -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 lg:gap-16 items-center fade-in">
        <div class="order-2 md:order-1">
          <SectionTitle title="Misión" />
          <p class="text-lg text-slate-600 leading-relaxed">
            Ser referentes en el cuidado de la salud cardiovascular, brindar
            información y ayudas diagnósticas a toda la población del Eje
            Cafetero, servir como medio para un diagnóstico oportuno, mediante
            monitorizaciones de 24 horas de la presión arterial, toma de
            electrocardiograma y consultas médicas comprometidas, ser asequibles y
            accesibles a toda la comunidad, generando un sentido de
            responsabilidad en la educación y la prevención de la hipertensión
            arterial.
          </p>
        </div>
        <div class="order-1 md:order-2">
          <img
            class="rounded-2xl shadow-xl w-full object-cover"
            src={misionMonitor}
            alt="Monitor de presión arterial — Misión"
          />
        </div>
      </div>

      <!-- Visión -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 lg:gap-16 items-center fade-in">
        <div>
          <img
            class="rounded-2xl shadow-xl w-full object-cover"
            src={visionMonitor}
            alt="Monitor de presión arterial — Visión"
          />
        </div>
        <div>
          <SectionTitle title="Visión" />
          <p class="text-lg text-slate-600 leading-relaxed">
            En 2026 llegar a ser parte del equipo HEARTS de la OPS, para ser
            reconocidos como una entidad que vela por la salud cardiovascular de
            los quindianos.
          </p>
        </div>
      </div>

    </div>
  </main>

  <Footer />
</BaseLayout>
