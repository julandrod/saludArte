---
import Footer from "../components/Footer.astro";
import BaseLayout from "./BaseLayout.astro";
import SectionTitle from "../components/SectionTitle.astro";
import Navbar from "../components/Navbar";
const {
  frontmatter: { title, image },
} = Astro.props;
---

<BaseLayout>
  <Navbar client:load />

  <main class="bg-white py-20 md:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

      <SectionTitle title={title} label="EDUCACIÓN" />

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-start">

        <!-- Markdown content -->
        <div class="prose prose-slate prose-lg max-w-none
          [&>p]:text-slate-700 [&>p]:leading-relaxed [&>p]:mb-5
          [&>h2]:font-bold [&>h2]:text-slate-900 [&>h2]:mt-8 [&>h2]:mb-4
          [&>ul]:text-slate-700 [&>ul]:pl-5 [&>ul]:list-disc [&>ul]:space-y-2
          [&>ol]:text-slate-700 [&>ol]:pl-5 [&>ol]:list-decimal [&>ol]:space-y-2">
          <slot />
        </div>

        <!-- Article image -->
        {image && (
          <div>
            <img
              src={image}
              alt={title}
              class="rounded-2xl shadow-xl w-full object-cover sticky top-24"
            />
          </div>
        )}

      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>
